{
  "name": "ai-social-media-automation-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11.8.0",
  "description": "Production-ready SaaS for Instagram/Facebook comment-to-DM automation, AI conversations, analytics, and multi-brand management.",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm run dev -w @aisma/api\" \"npm run dev -w @aisma/web\"",
    "dev:turbo": "turbo dev",
    "dev:api": "npm run dev -w @aisma/api",
    "dev:web": "npm run dev -w @aisma/web",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\"",
    "db:generate": "npm --workspace @aisma/database run generate",
    "db:migrate": "npm --workspace @aisma/database run migrate"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "concurrently": "^9.2.1",
    "pm2": "^7.0.1",
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "dependencies": {
    "jose": "^6.2.3",
    "playwright": "^1.60.0"
  }
}
