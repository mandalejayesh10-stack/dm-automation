{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "JWT_SECRET",
        "NEXT_PUBLIC_AUTH_BACKEND_URL",
        "NEXT_PUBLIC_META_BACKEND_URL",
        "ai_dev",
        "ai_dev2"
      ],
      "outputs": [".next/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^typecheck"]
    }
  }
}
